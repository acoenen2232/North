# Copy this file to .env.local and fill it in. .env.local is never committed.

# Vera (the AI coach). Get a key at https://console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# Optional: change which Claude models Vera uses.
# VERA_DAILY_MODEL=claude-sonnet-5-5
# VERA_WEEKLY_MODEL=claude-fable-5-1

# Nightly backups (2 AM) go here, e.g. a USB drive. Leave empty to turn off.
NORTH_BACKUP_DIR=

# Where the database lives. Default: ./data/north.db
# NORTH_DB_PATH=

# Contact for the push service (Apple/Google). Any email you own.
# NORTH_PUSH_CONTACT=mailto:you@example.com
